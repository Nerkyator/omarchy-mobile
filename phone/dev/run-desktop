#!/bin/bash
# SPDX-License-Identifier: MIT
# run-desktop: run the Omarchy phone profile in a phone-sized nested Hyprland window.
#
# Nothing in your real ~/.config is touched: the shell runs with its own home
# directory under ~/android/phone-dev/home, which links in your current theme
# and this repo's phone plugins.
set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/../.." && pwd)"
DEV="${PHONE_DEV:-$HOME/android/phone-dev}"
OMARCHY_PATH="${OMARCHY_PATH:-/usr/share/omarchy}"
FAKE_HOME="$DEV/home"

# A private copy of the shell gives it its own config path, so IPC calls
# can't reach the desktop's running shell by accident (and vice versa)
mkdir -p "$DEV"
rsync -a --delete "$OMARCHY_PATH/shell/" "$DEV/shell/"

mkdir -p "$FAKE_HOME/.config/omarchy" "$FAKE_HOME/.local/state/omarchy"
ln -sfn "$HOME/.local/state/omarchy/current" "$FAKE_HOME/.local/state/omarchy/current"
ln -sfn "$ROOT/packages/omamobile-shell/plugins" "$FAKE_HOME/.config/omarchy/plugins"
# Copied, not linked: the shell writes to shell.json when settings change
cp "$ROOT/packages/omamobile-shell/profile/shell.json" "$FAKE_HOME/.config/omarchy/shell.json"

# Size the window to the screen: the largest 6n x 13n (the phone's 13:6
# shape) that fits the focused monitor beside its bars, with n a multiple of
# 10 up to 100. The nested monitor's scale n/80 keeps 480x1040 logical
# pixels like the real phone. With n a multiple of 10 the scale is a multiple
# of 1/8, exact in floating point, so Hyprland finds the logical size whole
# and keeps the scale; at other n it can come out a hair off, and Hyprland
# then picks another scale. n = 100 is 600x1300 at scale 1.25.
read -r W H SCALE < <(hyprctl monitors -j 2>/dev/null | python3 -I -c 'import json,sys
try:
    m = next(x for x in json.load(sys.stdin) if x["focused"])
    w, h = m["width"] / m["scale"], m["height"] / m["scale"]
    if m["transform"] % 2:
        w, h = h, w
    l, t, r, b = m["reserved"]
    # 24 leaves room for the border and a little space around the window
    n = min(100, int(w - l - r - 24) // 6, int(h - t - b - 24) // 13) // 10 * 10
except Exception:
    n = 100
n = max(n, 20)
print(6 * n, 13 * n, n / 80)')
export PHONE_DEV_MODE="${W}x$H" PHONE_DEV_SCALE="$SCALE"

# Once the nested window appears on the desktop, float it at that size.
# Uses the desktop compositor's own dispatchers; no config changes.
(
  for _ in $(seq 1 50); do
    addr=$(hyprctl clients -j 2>/dev/null | python3 -I -c 'import json,sys
c=[x for x in json.load(sys.stdin) if x.get("class")=="aquamarine"]
print(c[-1]["address"] if c else "")')
    if [[ -n "$addr" ]]; then
      w="address:$addr"
      hyprctl dispatch "hl.dsp.window.float({ window = \"$w\", action = \"enable\" })" >/dev/null
      hyprctl dispatch "hl.dsp.window.resize({ window = \"$w\", x = $W, y = $H })" >/dev/null
      hyprctl dispatch "hl.dsp.window.center({ window = \"$w\" })" >/dev/null 2>&1 || true
      break
    fi
    sleep 0.2
  done
) &

export PHONE_DEV_SHELL_CMD="env HOME=$FAKE_HOME OMARCHY_PATH=$OMARCHY_PATH quickshell -p $DEV/shell"
exec env -u HYPRLAND_INSTANCE_SIGNATURE Hyprland -c "$ROOT/phone/dev/hyprland.lua"
