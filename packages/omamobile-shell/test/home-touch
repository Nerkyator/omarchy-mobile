#!/bin/bash
# SPDX-License-Identifier: MIT
# The home screen (omamobile.home) under a mouse and under touch (#147),
# offscreen in qmltestrunner: the real Home.qml with its tiles and widgets,
# Quickshell and Omarchy's modules stubbed (test/qml-stubs) and its
# layer-shell window a plain Item, as in test/home-render. No compositor,
# no Quickshell: nothing runs (the stubs record what would) and no file is
# read or written. Exits 77 without qmltestrunner.
set -euo pipefail
here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
plugin=$here/../plugins/omamobile.home
runner=$(command -v qmltestrunner6 || command -v /usr/lib/qt6/bin/qmltestrunner || command -v qmltestrunner || true)
[[ -n $runner ]] || { echo "home-touch: no qmltestrunner" >&2; exit 77; }

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
cp -r "$plugin" "$work/home"
sed -i -E \
  -e '/^    (screen: Quickshell\.screens|anchors \{ top: true|exclusionMode:|WlrLayershell\.|color: "transparent")/d' \
  -e 's/^  PanelWindow \{$/  Item { anchors.fill: parent/' \
  "$work/home/Home.qml"
grep -c '^  Item { anchors.fill: parent$' "$work/home/Home.qml" >/dev/null || { echo "home-touch: no PanelWindow to stand in for" >&2; exit 1; }
cp "$here/home-touch.qml" "$work/tst_home_touch.qml"

export QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software QML_DISABLE_DISK_CACHE=1
# Not exec'd, so the trap removes the copy.
"$runner" -import "$here/qml-stubs" -input "$work/tst_home_touch.qml"
