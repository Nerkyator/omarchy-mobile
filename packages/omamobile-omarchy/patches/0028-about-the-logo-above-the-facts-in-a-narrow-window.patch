# About: in a window too narrow for the logo beside the system facts (a
# phone, a portrait monitor, a tiled column), the logo goes above the facts,
# or is left out where the two would run past the bottom. A phone's About
# window is 65 columns by 56 rows; Omarchy's layout is 116 columns wide, so it
# showed the logo and one column of the facts. The choice is made in terminal
# cells at every repaint, so it holds for any font and follows a resize or a
# rotation (the render loop already repaints on those). A window wide enough
# keeps the side-by-side layout, and a user-level fastfetch config keeps its
# own. The facts are measured once per launch, and the fit uses that same
# measurement instead of its own. Candidate for upstream Omarchy.
#
# Against Omarchy 4.0.6 (4.0.6-1).
diff --git i/bin/omarchy-launch-about w/bin/omarchy-launch-about
--- i/bin/omarchy-launch-about
+++ w/bin/omarchy-launch-about
@@ -91,6 +91,42 @@
   done
 }
 
+# The columns and rows the system facts take without the logo. The guard
+# character keeps command substitution from eating the trailing break line,
+# which provides the bottom padding row.
+module_dimensions() {
+  local modules
+  modules=$(fastfetch --logo none | sed 's/\x1b\[[0-9;?]*[a-zA-Z]//g'; printf X)
+  modules=${modules%X}
+  printf '%s %s' "$(printf '%s' "$modules" | display_columns)" "$(printf '%s' "$modules" | wc -l)"
+}
+
+# The logo sits beside the facts wherever the window is wide enough. A window
+# that isn't (a phone, a portrait monitor, a tiled column) shows the logo above
+# the facts, or the facts alone where the two would run past the bottom, so the
+# logo never pushes the facts out of view. A user-level fastfetch config keeps
+# its own layout.
+logo_layout() {
+  custom_fastfetch_config && return 0
+
+  local logo_w logo_h module_w module_h rows cols
+  read -r logo_w logo_h <<<"$(logo_dimensions)"
+  read -r module_w module_h <<<"$module_size"
+  [[ -n ${logo_w:-} && -n ${module_w:-} ]] || return 0
+  read -r rows cols <<<"$(stty size)"
+
+  # Side by side takes the padding left of the logo, the logo, the gap and the
+  # facts. Stacked, fastfetch keeps the 2 rows above the logo and leaves a blank
+  # row under it; then come the facts, and a row for the cursor.
+  if (( cols >= 2 + logo_w + 6 + module_w )); then
+    return 0
+  elif (( cols >= 2 + logo_w && rows >= 2 + logo_h + 1 + module_h + 1 )); then
+    echo "--logo-position top"
+  else
+    echo "--logo none"
+  fi
+}
+
 fit_window() {
   custom_fastfetch_config && return 0
 
